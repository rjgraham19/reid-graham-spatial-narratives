    }
  },
  "project.townhouse.description": {
    "base": {
      "text": "Inspired by W.G. Clark and Charles Menefee’s Croffead House, this residential design creates portals of varying material transparency—from solid concrete to translucent glass block to transparent glass—in an exploration of public versus private space within the domestic footprint."
    },
    "desktop": {
      "offsetX": -11,
      "offsetY": 179
    }
