  "project.tab-renaissance.description": {
    "base": {
      "text": "An immersive, experiential design for Taubman College’s annual Beaux-Arts Ball,\n\nreimagining the Renaissance as a timeless expression of creative transformation and continual innovation."
    },
    "desktop": {
